# ═══════════════════════════════════════════════════════════════════════════
# Strix Pro - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────────
STRIX_ENV=development
STRIX_API_URL=http://localhost:8000
STRIX_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
STRIX_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./strix.db
# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/strix

# ── AI Providers (set at least one) ──────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Default AI Settings ──────────────────────────────────────────────────
STRIX_DEFAULT_PROVIDER=openai
STRIX_DEFAULT_MODEL=gpt-4o
STRIX_AI_TEMPERATURE=0.7
STRIX_AI_MAX_TOKENS=4096

# ── GitHub Integration ───────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ── Report Generation ────────────────────────────────────────────────────
STRIX_REPORTS_DIR=./reports
STRIX_REPORT_FORMAT=pdf

# ── Scheduler ─────────────────────────────────────────────────────────────
STRIX_SCHEDULER_ENABLED=true
STRIX_SCHEDULER_TIMEZONE=UTC

# ── Web Server ────────────────────────────────────────────────────────────
STRIX_HOST=0.0.0.0
STRIX_PORT=8000
STRIX_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
STRIX_WORKERS=1

# ── Authentication ────────────────────────────────────────────────────────
STRIX_AUTH_ENABLED=true
STRIX_JWT_ALGORITHM=HS256
STRIX_JWT_EXPIRE_MINUTES=1440

# ── Frontend (for docker-compose) ────────────────────────────────────────
FRONTEND_PORT=3000
